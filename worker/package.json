{
  "name": "artists-in-residence-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Artists in Residence: a free remote MCP server of real public-domain works by Leonardo da Vinci, Isaac Newton, Santiago Ramón y Cajal, El Lissitzky and Lewis Hine.",
  "type": "module",
  "scripts": {
    "assets": "python3 ../catalog/assets.py",
    "dev": "npm run assets && wrangler dev",
    "deploy": "npm run assets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/search.test.ts",
    "live": "node scripts/live_cases.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.120.0"
  }
}
