{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artists-in-residence",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static files (icon, the curated issue sheets at sheets/ and thumbs/) are served by
  // Cloudflare's asset layer before the Worker runs: free and not counted as Worker requests.
  // public/sheets and public/thumbs are generated by catalog/assets.py (npm run assets).
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Per-day, per-tool call counts + the hard daily cap (src/usage.ts). Schema: migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "artists-in-residence-usage",
      "database_id": "27f2a990-97ad-409b-8838-895b3558405c", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Refuse tool calls past this many per UTC day. Workers Free allows 100,000 requests and
    // D1 Free 100,000 row writes a day; one call is one request and one write.
    "DAILY_CALL_CAP": "20000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
